<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.GdsViewer">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="standard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Filter A: "Open with" by MIME type. File managers and mail apps usually report
                 unknown extensions such as .gds as application/octet-stream; .gds.gz is gzip. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-gds" />
                <data android:mimeType="application/x-gdsii" />
                <data android:mimeType="application/vnd.gds" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
            </intent-filter>

            <!-- Filter B: "Open with" by file name. Some apps send the generic type */*, so we
                 only accept names ending in .gds / .gds.gz (otherwise we would be offered for
                 every file). pathPattern cannot backtrack, so there is one variant per number
                 of earlier dots in the name; pathSuffix (API 31+) does it properly and is
                 ignored on older versions. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gds" />
                <data android:pathPattern=".*\\..*\\.gds" />
                <data android:pathPattern=".*\\..*\\..*\\.gds" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gds" />
                <data android:pathPattern=".*\\.GDS" />
                <data android:pathPattern=".*\\..*\\.GDS" />
                <data android:pathPattern=".*\\..*\\..*\\.GDS" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.GDS" />
                <data android:pathPattern=".*\\.gds\\.gz" />
                <data android:pathPattern=".*\\..*\\.gds\\.gz" />
                <data android:pathPattern=".*\\..*\\..*\\.gds\\.gz" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gds\\.gz" />
                <data android:pathPattern=".*\\.GDS\\.GZ" />
                <data android:pathPattern=".*\\..*\\.GDS\\.GZ" />
                <data android:pathPattern=".*\\..*\\..*\\.GDS\\.GZ" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.GDS\\.GZ" />
                <data tools:ignore="UnusedAttribute" android:pathSuffix=".gds" />
                <data tools:ignore="UnusedAttribute" android:pathSuffix=".GDS" />
                <data tools:ignore="UnusedAttribute" android:pathSuffix=".gds.gz" />
                <data tools:ignore="UnusedAttribute" android:pathSuffix=".GDS.GZ" />
            </intent-filter>

            <!-- Filter C: "Share to" - lets other apps send a GDSII file to this viewer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-gds" />
                <data android:mimeType="application/x-gdsii" />
                <data android:mimeType="application/vnd.gds" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
            </intent-filter>
        </activity>
    </application>

</manifest>
