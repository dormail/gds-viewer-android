<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: nothing of the app (recent files, copies of opened layouts, settings)
     goes into cloud backups or to a new phone, because layouts are often confidential.
     android:allowBackup="false" does the same on older versions. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
