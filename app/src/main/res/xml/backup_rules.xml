<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: exclude everything, like data_extraction_rules.xml for newer versions.
     android:allowBackup="false" already turns backups off; this only makes sure. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
